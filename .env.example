# Credentials
DISCORD_TOKEN=
OPENROUTER_API_KEY=sk-or-v1-...

# AI
FREE_MODELS_ONLY=true # If set to true, only openrouter/free or ids ending in :free will be allowed.
MODELS=openrouter/free # Comma-separated list, first one is primary and any others are fallbacks.
MAX_TOKENS=2000 # For free models, 2000 should be enough. Obviously depends on the use case.

# Channels
SUPPORT_CHANNEL_IDS=1560450225410408599 # Will always respond to messages in these channels, even if not mentioned/replied to/DMed. Comma-separated.

# Messages
HISTORY_LIMIT=12 # Limit of message history to keep in memory for context.
KNOWLEDGE_FILE=knowledge.md # Self-explanatory
